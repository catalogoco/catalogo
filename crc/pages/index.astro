---
import Base from "../layouts/Base.astro";
import config from "../data/config.json";
import categorias from "../data/categorias.json";
import productos from "../data/productos.json";

const conteo = (slug: string) => productos.filter((p) => p.categoria === slug).length;
---
<Base titulo={`${config.nombre} | Productos al detal y al por mayor`} descripcion={config.descripcion}>
  <h1>{config.nombre}</h1>
  <p>{config.descripcion}</p>

  <div class="grilla">
    {categorias.map((c) => (
      <a class="tarjeta" href={`/${c.slug}`}>
        <h2>{c.nombre}</h2>
        <span>{conteo(c.slug)} productos</span>
      </a>
    ))}
  </div>
</Base>
