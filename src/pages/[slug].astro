---
import Base from "../layouts/Base.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import config from "../data/config.json";
import {
  productos,
  labsConProductos,
  catsConProductos,
  labPorSlug,
  catPorSlug,
  productosDeLab,
  productosDeCat,
  pesos,
  wa,
  nombreCompleto,
  validar,
} from "../lib/catalogo.js";

export function getStaticPaths() {
  validar();

  const rutas = [
    ...catsConProductos.map((c) => ({
      params: { slug: c.slug },
      props: { tipo: "categoria", item: c, hijos: productosDeCat(c.slug) },
    })),
    // Las páginas de laboratorio llevan el prefijo "laboratorio-" en la URL.
    ...labsConProductos.map((l) => ({
      params: { slug: `laboratorio-${l.slug}` },
      props: { tipo: "laboratorio", item: l, hijos: productosDeLab(l.slug) },
    })),
    ...productos.map((p) => ({
      params: { slug: p.slug },
      props: {
        tipo: "producto",
        item: p,
        lab: labPorSlug[p.laboratorio],
        categoria: catPorSlug[p.categoriaPrincipal] ?? catPorSlug[(p.categorias ?? [])[0]],
      },
    })),
  ];

  const finales = rutas.map((r) => r.params.slug);
  const repetidos = finales.filter((s, i) => finales.indexOf(s) !== i);
  if (repetidos.length) throw new Error(`Slugs repetidos: ${[...new Set(repetidos)].join(", ")}`);

  return rutas;
}

const { tipo, item, hijos = [], lab, categoria } = Astro.props as any;
const urlAbs = (ruta: string) => new URL(ruta, Astro.site).href;
const fotos: string[] = item.imagenes ?? [];

let titulo = "";
let descripcion = "";
let jsonLd: any = {};

if (tipo === "producto") {
  titulo = `${nombreCompleto(item)} | ${lab.nombre} | ${config.nombre}`;
  descripcion = item.descripcionCorta;
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Product",
    name: nombreCompleto(item),
    description: item.descripcionCorta,
    ...(fotos.length ? { image: fotos.map((u) => (u.startsWith("http") ? u : urlAbs(u))) } : {}),
    brand: { "@type": "Brand", name: lab.nombre },
    ...(item.registroInvima
      ? { additionalProperty: { "@type": "PropertyValue", name: "Registro sanitario INVIMA", value: item.registroInvima } }
      : {}),
    offers: {
      "@type": "Offer",
      priceCurrency: "COP",
      price: item.precioDetal,
      availability: "https://schema.org/InStock",
      url: urlAbs(Astro.url.pathname),
    },
  };
} else if (tipo === "laboratorio") {
  titulo = `Productos ${item.nombre} | Distribuidor al por mayor | ${config.nombre}`;
  descripcion = item.descripcion || `Productos del laboratorio ${item.nombre}, al detal y al por mayor.`;
  jsonLd = { "@context": "https://schema.org", "@type": "CollectionPage", name: `Productos ${item.nombre}`, description: descripcion };
} else {
  titulo = `${item.nombre} | ${config.nombre}`;
  descripcion = item.descripcion;
  jsonLd = { "@context": "https://schema.org", "@type": "CollectionPage", name: item.nombre, description: item.descripcion };
}
---
<Base titulo={titulo} descripcion={descripcion} jsonLd={jsonLd} imagen={tipo === "producto" ? fotos[0] : undefined}>
  {tipo === "producto" ? (
    <>
      <nav class="migas">
        <a href="/">Inicio</a>
        {categoria && <> › <a href={`/${categoria.slug}`}>{categoria.nombre}</a></>} › {item.nombre}
      </nav>

      <div class="producto">
        <div class="galeria">
          <div class="foto">
            {fotos[0] ? <img src={fotos[0]} alt={`${nombreCompleto(item)} ${lab.nombre}`} /> : <span>Foto pendiente</span>}
          </div>
          {fotos.length > 1 && (
            <div class="miniaturas">
              {fotos.map((u, i) => (
                <a href={u} target="_blank" rel="noopener">
                  <img src={u} alt={`${item.nombre} foto ${i + 1}`} loading="lazy" />
                </a>
              ))}
            </div>
          )}
        </div>

        <div class="info">
          <h1>{item.nombre}</h1>
          <p class="lab">
            {item.presentacion} · Laboratorio: <a href={`/laboratorio-${lab.slug}`}>{lab.nombre}</a>
          </p>
          {item.registroInvima && <p class="lab">Registro sanitario INVIMA: {item.registroInvima}</p>}
          <p class="precio">Precio al detal: {pesos(item.precioDetal)}</p>
          <div class="botones">
            <a class="btn btn-detal" href={wa(config.whatsappDetal, `Hola, quiero comprar al detal: ${nombreCompleto(item)} (${lab.nombre})`)}>
              Comprar al detal
            </a>
            <a class="btn btn-mayor" href={wa(config.whatsappMayor, `Hola, quiero cotizar al por mayor: ${nombreCompleto(item)} (${lab.nombre})`)}>
              Pedir al por mayor (desde {config.minimoMayor} unidades)
            </a>
          </div>
        </div>
      </div>

      <div class="descripcion" set:html={item.descripcionHtml} />
    </>
  ) : (
    <>
      <nav class="migas">
        <a href="/">Inicio</a> › {tipo === "laboratorio" ? `Laboratorio ${item.nombre}` : item.nombre}
      </nav>
      <h1>{tipo === "laboratorio" ? `Productos ${item.nombre}` : item.nombre}</h1>
      {item.descripcion && <p>{item.descripcion}</p>}
      <div class="grilla">
        {hijos.map((p: any) => <TarjetaProducto producto={p} />)}
      </div>
    </>
  )}
</Base>
