---
import Base from "../layouts/Base.astro";
import config from "../data/config.json";
import categorias from "../data/categorias.json";
import laboratorios from "../data/laboratorios.json";
import productos from "../data/productos.json";

const pesos = (n: number) => "$" + n.toLocaleString("es-CO");
const labs = laboratorios
  .map((l) => ({ ...l, total: productos.filter((p: any) => p.laboratorio === l.slug).length }))
  .filter((l) => l.total > 0);
const cats = categorias
  .map((c) => ({ ...c, total: productos.filter((p: any) => p.categorias.includes(c.slug)).length }))
  .filter((c) => c.total > 0);
---
<Base titulo={`${config.nombre} | Productos al detal y al por mayor`} descripcion={config.descripcion}>
  <h1>{config.nombre}</h1>
  <p>{config.descripcion}</p>

  <h2>Laboratorios</h2>
  <div class="grilla">
    {labs.map((l) => (
      <a class="tarjeta" href={`/laboratorio-${l.slug}`}>
        <h2>{l.nombre}</h2>
        <span>{l.total} productos</span>
      </a>
    ))}
  </div>

  <h2>Categorías</h2>
  <div class="grilla">
    {cats.map((c) => (
      <a class="tarjeta" href={`/${c.slug}`}>
        <h2>{c.nombre}</h2>
        <span>{c.total} productos</span>
      </a>
    ))}
  </div>

  <h2>Todos los productos</h2>
  <div class="grilla">
    {productos.map((p: any) => (
      <a class="tarjeta" href={`/${p.slug}`}>
        <div class="foto"><img src={p.imagenes[0]} alt={p.nombre} loading="lazy" /></div>
        <h2>{p.nombre}</h2>
        <span class="precio">{pesos(p.precioDetal)}</span>
      </a>
    ))}
  </div>
</Base>
