---
import Base from "../layouts/Base.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import config from "../data/config.json";
import { productos, labsConProductos, catsConProductos, productosDeLab, productosDeCat } from "../lib/catalogo.js";
---
<Base titulo={`${config.nombre} | Productos al detal y al por mayor`} descripcion={config.descripcion}>
  <h1>{config.nombre}</h1>
  <p>{config.descripcion}</p>

  <h2 class="seccion">Laboratorios</h2>
  <div class="grilla">
    {labsConProductos.map((l) => (
      <a class="tarjeta tarjeta-texto" href={`/laboratorio-${l.slug}`}>
        <h2>{l.nombre}</h2>
        <span class="detalle">{productosDeLab(l.slug).length} productos</span>
      </a>
    ))}
  </div>

  <h2 class="seccion">Categorías</h2>
  <div class="grilla">
    {catsConProductos.map((c) => (
      <a class="tarjeta tarjeta-texto" href={`/${c.slug}`}>
        <h2>{c.nombre}</h2>
        <span class="detalle">{productosDeCat(c.slug).length} productos</span>
      </a>
    ))}
  </div>

  <h2 class="seccion">Todos los productos</h2>
  <div class="grilla">
    {productos.map((p: any) => <TarjetaProducto producto={p} />)}
  </div>
</Base>
