---
import Base from "../layouts/Base.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import config from "../data/config.json";
import { productos, labsConProductos, catsConProductos, productosDeLab, productosDeCat } from "../lib/catalogo.js";

const titulo = `${config.nombre} | Productos al detal y por mayor`.slice(0, 60);
const descripcion = config.descripcion.length > 160
  ? config.descripcion.slice(0, 157) + "..."
  : config.descripcion;

const urlSitio = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL("/", urlSitio).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${canonical}#organizacion`,
      name: config.nombre,
      url: canonical,
      description: descripcion,
    },
    {
      "@type": "WebSite",
      "@id": `${canonical}#sitio`,
      url: canonical,
      name: config.nombre,
      inLanguage: "es-CO",
      publisher: { "@id": `${canonical}#organizacion` },
    },
    {
      "@type": "CollectionPage",
      name: titulo,
      url: canonical,
      isPartOf: { "@id": `${canonical}#sitio` },
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: productos.length,
        itemListElement: labsConProductos.map((l, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: l.nombre,
          url: new URL(`/laboratorio-${l.slug}`, urlSitio).href,
        })),
      },
    },
  ],
};
---
<Base titulo={titulo} descripcion={descripcion} canonical={canonical}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header>
    <h1>{config.nombre}: productos al detal y por mayor</h1>
    <p>{config.descripcion}</p>
  </header>

  <section aria-labelledby="h-labs">
    <h2 id="h-labs" class="seccion">Laboratorios</h2>
    <ul class="grilla" role="list">
      {labsConProductos.map((l) => (
        <li>
          <a class="tarjeta tarjeta-texto" href={`/laboratorio-${l.slug}`}
             title={`Productos del laboratorio ${l.nombre}`}>
            <h3>{l.nombre}</h3>
            <span class="detalle">{productosDeLab(l.slug).length} productos</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="h-cats">
    <h2 id="h-cats" class="seccion">Categorías</h2>
    <ul class="grilla" role="list">
      {catsConProductos.map((c) => (
        <li>
          <a class="tarjeta tarjeta-texto" href={`/${c.slug}`}
             title={`Ver categoría ${c.nombre}`}>
            <h3>{c.nombre}</h3>
            <span class="detalle">{productosDeCat(c.slug).length} productos</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="h-prods">
    <h2 id="h-prods" class="seccion">Todos los productos</h2>
    <div class="grilla">
      {productos.map((p: any, i: number) => (
        <TarjetaProducto producto={p} prioridad={i < 4} />
      ))}
    </div>
  </section>
</Base>
