---
import Base from "../layouts/Base.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import config from "../data/config.json";
import { productos, labsConProductos, catsConProductos, productosDeLab, productosDeCat } from "../lib/catalogo.js";
import "../styles/global.css";

const siteUrl = "https://catalogo.com.co/";
const title = "catalogo | Bebidas, productos naturales y suplementos";
const description =
  "Descubre catalogo, una marca comercial con bebidas, productos naturales y suplementos de diferentes fabricantes. Explora el catálogo y consulta las presentaciones disponibles.";

const ogImage = `${siteUrl}images/og-catalogo.jpg`;
const instagram = "https://www.instagram.com/catalogoco/";

const productosVisibles = productos.filter(
  (producto) => producto.publicar !== false
);

const categoriasVisibles = categorias;

const laboratoriosVisibles = laboratorios;

const formatoPrecio = (precio) =>
  new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    maximumFractionDigits: 0,
  }).format(precio ?? 0);

const nombreLaboratorio = (slug) =>
  laboratorios.find((laboratorio) => laboratorio.slug === slug)?.nombre ??
  "Fabricante por confirmar";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "catalogo",
      url: siteUrl,
      logo: `${siteUrl}icons/catalogo-192.png`,
      email: "hola@catalogo.co",
      sameAs: [instagram],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "catalogo",
      description,
      inLanguage: "es-CO",
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
};
---
<Base titulo={titulo} descripcion={descripcion} canonical={canonical}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header>
    <h1>{config.nombre}: productos al detal y por mayor</h1>
    <p>{config.descripcion}</p>
  </header>

  <section aria-labelledby="h-labs">
    <h2 id="h-labs" class="seccion">Laboratorios</h2>
    <ul class="grilla" role="list">
      {labsConProductos.map((l) => (
        <li>
          <a class="tarjeta tarjeta-texto" href={`/laboratorio-${l.slug}`}
             title={`Productos del laboratorio ${l.nombre}`}>
            <h3>{l.nombre}</h3>
            <span class="detalle">{productosDeLab(l.slug).length} productos</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="h-cats">
    <h2 id="h-cats" class="seccion">Categorías</h2>
    <ul class="grilla" role="list">
      {catsConProductos.map((c) => (
        <li>
          <a class="tarjeta tarjeta-texto" href={`/${c.slug}`}
             title={`Ver categoría ${c.nombre}`}>
            <h3>{c.nombre}</h3>
            <span class="detalle">{productosDeCat(c.slug).length} productos</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="h-prods">
    <h2 id="h-prods" class="seccion">Todos los productos</h2>
    <div class="grilla">
      {productos.map((p: any, i: number) => (
        <TarjetaProducto producto={p} prioridad={i < 4} />
      ))}
    </div>
  </section>
</Base>
